# Copia este archivo como .env y pon tus claves reales.
# El archivo .env NUNCA se comparte ni se sube a git.
# En Railway estas variables se ponen en el panel (Variables), no en un archivo.

# ── Claude ──────────────────────────────────────────────
# Tu clave de la API de Anthropic (https://platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-pon-tu-clave-aqui

# Modelo de Claude que usa el agente.
# Opciones: claude-sonnet-5-5 (recomendado), claude-opus-5-5 (más capaz, más caro),
#           claude-haiku-5-5 (más barato y rápido)
MODELO=claude-sonnet-5-5

# Cuánto "piensa" el modelo antes de responder: low | medium | high
# Para un chat de atención al cliente, low suele bastar y responde más rápido.
ESFUERZO=low

# ── WhatsApp Cloud API (developers.facebook.com -> tu app -> WhatsApp) ──
# Token de acceso. El temporal caduca a las 24 h; en Railway usa uno permanente.
WHATSAPP_TOKEN=pon-tu-token-aqui
# "Phone number ID" (un número largo de Meta, NO es el teléfono)
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Palabra secreta que inventas tú; la misma se pone en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=inventa-una-palabra-secreta
# Configuración de la app -> Básica -> "Clave secreta de la app"
WHATSAPP_APP_SECRET=pon-tu-app-secret-aqui
# Versión de la Graph API de Meta
GRAPH_API_VERSION=v26.0

# ── Administración ──────────────────────────────────────
# Tu celular personal, con código de país, sin + ni espacios (ej. 51987654321)
NUMERO_ADMIN=51XXXXXXXXX

# ── Base de datos ───────────────────────────────────────
# En tu PC basta con asunvic.db. En Railway: /data/asunvic.db (en un Volume)
DB_PATH=asunvic.db
# Si un cliente no escribe en estos días, su conversación empieza de cero
DIAS_REINICIO_HISTORIAL=7
# Después de archivarse, en cuántos días se borra definitivamente.
# Si lo cambias, la página /privacidad se actualiza sola.
DIAS_CONSERVAR_ARCHIVO=90
